# Local test values for `npx wrangler dev` (copy to .dev.vars, which is git-ignored).
# In production these are Cloudflare secrets: run `npx wrangler secret put NAME` for each.
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=any-long-random-string

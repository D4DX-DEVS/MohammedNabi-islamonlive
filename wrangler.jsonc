{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muhammad-nabi",
  "compatibility_date": "2026-10-01",
  // Static files only: no Worker script, so no CPU limit applies and requests are not billed per invocation.
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page"
  }
}

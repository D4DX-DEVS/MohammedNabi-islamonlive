{
  // Only used by `npm run db:seed` (the wrangler CLI). The site itself runs on Vercel and reads D1 over Cloudflare's REST API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muhammad-nabi-tools",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "muhammednabi", "database_id": "41655fd1-4fc7-42f0-b709-9835388c730f" }
  ]
}

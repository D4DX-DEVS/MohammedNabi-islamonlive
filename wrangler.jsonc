{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muhammad-nabi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // the Worker calls itself to render a page, so a render cut off by the free plan's CPU limit can be retried (see worker/index.ts)
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "muhammad-nabi" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "muhammednabi", "database_id": "41655fd1-4fc7-42f0-b709-9835388c730f" }
  ],
  // photos uploaded in the admin (media/...) and the stored pages (cache/...)
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "muhammednabi" }],
  // only the address in SITE_URL is indexed by search engines; every other address serving this Worker is noindex
  "vars": { "SITE_URL": "https://muhammad-nabi.d4dx-fatwa.workers.dev" },
  // renders a few pages nobody has asked for yet on every run, so most pages are stored before their first visit
  "triggers": { "crons": ["*/5 * * * *"] }
}

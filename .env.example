# Copy to .env and fill in. .env is git-ignored; never commit real values.
# The site is built once into static files, so these are only needed on the machine (or CI) that runs `npm run build`.
# Nothing here is needed by the live site.

# Public address of the site, with https:// and no trailing slash (sitemap, canonical links, sharing tags).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public address of the R2 bucket that holds the photos (bucket settings > Public access / custom domain).
# Photos are loaded from <this>/uploads/... Leave unset in plain local dev to use public/uploads instead.
NEXT_PUBLIC_MEDIA_URL=https://media.your-domain.com

# Read access to the D1 database the pages are built from.
# Named D1_API_TOKEN on purpose: wrangler reads CLOUDFLARE_API_TOKEN for deploys and would use this token.
CLOUDFLARE_ACCOUNT_ID=
D1_API_TOKEN=
D1_DATABASE_ID=

# Only for `npm run r2:upload` (S3-compatible keys from R2 > Manage API tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=muhammednabi
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

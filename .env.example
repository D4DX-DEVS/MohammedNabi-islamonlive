# Copy to .env (local) and set the same names in Vercel: Project > Settings > Environment Variables.
# .env is git-ignored; never commit real values.

# --- Site ---
# Public address with https:// and no trailing slash. On Vercel it falls back to the production domain if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Cloudflare D1 (the database; read over Cloudflare's REST API) ---
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=          # token with Account > D1 > Read: used by the public pages
D1_ADMIN_API_TOKEN=    # token with Account > D1 > Edit: used only by the admin page

# --- Cloudflare R2 (photos uploaded in the admin), S3-compatible keys from R2 > Manage API tokens ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=muhammednabi
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- Admin login ---
ADMIN_PASSWORD=        # the password you type on /admin; make it long
SESSION_SECRET=        # any long random text: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

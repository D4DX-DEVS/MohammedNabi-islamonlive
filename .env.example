# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Where each variable is used is noted per line. The deployed Worker needs none of the secrets:
# it reads D1 and R2 through bindings declared in wrangler.jsonc.

# --- Build-time (also set this as a Cloudflare *build* variable) ---
# Public address of the site, with https:// and no trailing slash. Used for sitemap, canonical links, sharing tags.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Local development only (`next dev` / `next start` read D1 over Cloudflare's REST API) and the seed script ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=        # needs "D1: Edit" on this account
D1_DATABASE_ID=              # database "muhammednabi"; also in wrangler.jsonc

# --- Image upload script (`npm run r2:upload`), S3-compatible keys from R2 > Manage API tokens ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=muhammednabi
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

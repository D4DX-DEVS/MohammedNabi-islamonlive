# Copy to .env and fill in. .env is git-ignored; never commit real values.
# The site is built once into static files, so these are only needed on the machine (or CI) that runs `npm run build`.
# Nothing here is needed by the live site.

# Public address of the site, with https:// and no trailing slash (sitemap, canonical links, sharing tags).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Read access to the D1 database the pages are built from.
# Named D1_* on purpose: wrangler reads CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID for deploys, and the site
# may be hosted in a different Cloudflare account from the database.
D1_ACCOUNT_ID=
D1_API_TOKEN=
D1_DATABASE_ID=

# Copy to .env for a local build (`npm run build` reads the posts from D1). .env is git-ignored; never commit real values.
# In GitHub Actions the same names come from repository secrets (see DEPLOY.md).

# Public address with https:// and no trailing slash (sitemap, canonical links, sharing tags)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudflare D1, read at build time over Cloudflare's REST API
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=          # token with Account > D1 > Read

# Only for deploying by hand from this computer (`npx wrangler deploy` can also use `wrangler login`)
CF_DEPLOY_TOKEN=       # Cloudflare token from the "Edit Cloudflare Workers" template

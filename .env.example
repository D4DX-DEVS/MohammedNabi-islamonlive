# Copy to .env. It is git-ignored; never commit real values. Only NEXT_PUBLIC_SITE_URL ships with the site (scripts/strip-env.mjs).
# NOTE: Next also reads .env.local, which wins over .env: keep NEXT_PUBLIC_SITE_URL out of it or make sure it matches.

# Public address with https:// and no trailing slash (sitemap, canonical links, sharing tags). Read at build time.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Only for `npm run dev` (it has no Cloudflare binding, so it reads the real database over the REST API)
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=          # token with Account > D1 > Read
